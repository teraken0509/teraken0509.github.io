<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }} · {{ site.author }}</title>
  <link rel="shortcut icon" href="/img/favicon.ico">
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Saira+Extra+Condensed:500,700" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Muli:400,400i,800,800i" rel="stylesheet">
  <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/css/resume.min.css" rel="stylesheet">
  <link href="{{ '/assets/blog.css' | url }}" rel="stylesheet">
</head>
<body class="blog-page">
  <header class="blog-header">
    <div class="blog-header-inner">
      <a class="blog-brand" href="{{ '/' | url }}">{{ site.title }}</a>
      <nav class="blog-nav" aria-label="Site">
        <a href="{{ site.resumeUrl }}">Resume</a>
        <a href="{{ '/' | url }}" aria-current="{% if page.url == '/' %}page{% endif %}">Blog</a>
      </nav>
    </div>
  </header>

  <main class="blog-main">
    {{ content | safe }}
  </main>

  <footer class="blog-footer">
    <p>&copy; {{ site.author }} · <a href="{{ site.resumeUrl }}">Resume</a></p>
  </footer>
</body>
</html>
