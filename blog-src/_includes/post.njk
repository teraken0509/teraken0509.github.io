---
layout: base.njk
---
<article class="blog-post">
  <header class="blog-post-header">
    <p class="blog-meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
    </p>
    <h1>{{ title }}</h1>
    {% if description %}
    <p class="blog-lead">{{ description }}</p>
    {% endif %}
  </header>

  <div class="blog-content">
    {{ content | safe }}
  </div>

  <p class="blog-back">
    <a href="{{ '/' | url }}">← 記事一覧へ</a>
  </p>
</article>
